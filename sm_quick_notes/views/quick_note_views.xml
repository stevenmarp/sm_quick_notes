<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quick Note Tree View -->
    <record id="view_quick_note_tree" model="ir.ui.view">
        <field name="name">quick.note.tree</field>
        <field name="model">quick.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="content"/>
                <field name="color"/>
                <field name="is_pinned"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Quick Note Form View -->
    <record id="view_quick_note_form" model="ir.ui.view">
        <field name="name">quick.note.form</field>
        <field name="model">quick.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="is_pinned"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="content"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quick Note Action -->
    <record id="action_quick_note" model="ir.actions.act_window">
        <field name="name">Quick Notes</field>
        <field name="res_model">quick.note</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first quick note!
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_quick_notes"
        name="Quick Notes"
        action="action_quick_note"
        parent="mail.menu_root_discuss"
        sequence="99"/>
</odoo>
